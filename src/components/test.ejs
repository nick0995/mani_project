<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Test Page</title>
  <style>
    body { font-family: Arial; background: #eef2f5; padding: 20px; }
    .question-card {
      background: white; padding: 20px; margin-bottom: 20px;
      border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }
    .option { margin: 10px 0; }
  </style>
</head>
<body>

  <h2>Multiple Choice Questions</h2>

  <form method="POST" action="/submit">
    <% questions.forEach((q, index) => { %>
      <div class="question-card">
        <p><%= index + 1 %>. <%= q.question %></p>
        <div class="option"><input type="radio" name="q<%= q.id %>" value="A"> <%= q.option_a %></div>
        <div class="option"><input type="radio" name="q<%= q.id %>" value="B"> <%= q.option_b %></div>
        <div class="option"><input type="radio" name="q<%= q.id %>" value="C"> <%= q.option_c %></div>
        <div class="option"><input type="radio" name="q<%= q.id %>" value="D"> <%= q.option_d %></div>
      </div>
    <% }); %>

    <button type="submit">Submit Answers</button>
  </form>
  <div style="text-align: right; font-weight: bold; font-size: 18px;">
  Time Left: <span id="timer">10:00</span>
</div>

<script>
  let totalTime = 10 * 60; // 10 minutes

  const timerEl = document.getElementById('timer');
   const interval = setInterval(() => {
    const minutes = Math.floor(totalTime / 60);
    const seconds = totalTime % 60;
    timerEl.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
    totalTime--;

    if (totalTime < 0) {
      clearInterval(interval);
      alert("Time is up! Submitting your test.");
      document.querySelector('form').submit();
    }
  }, 1000);
</script>

</body>
</html>
